{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable",
            "ESNext.Decorators"
        ],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "@n3rdw1z4rd/engine": [
                "../engine/src/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "vite.config.ts",
        "vite-plugin-decorators.ts"
    ],
    "exclude": [
        "**/_*"
    ]
}